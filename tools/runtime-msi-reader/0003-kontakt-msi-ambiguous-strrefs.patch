     return last_col->offset + bytes_per_column( db, last_col, bytes_per_strref );
 }
 
+/* A table extent can be divisible by both string-reference row widths. Check
+ * the referenced strings as well before accepting the advertised width. */
+static BOOL table_strrefs_valid( MSIDATABASE *db, MSITABLE *table, const BYTE *data,
+                                UINT size, UINT width )
+{
+    UINT row_size = table_get_row_size( db, table->colinfo, table->col_count, width );
+    UINT rows, col, row, offset = 0;
+
+    if (!row_size || size % row_size >= 4) return FALSE;
+    rows = size / row_size;
+    for (col = 0; col < table->col_count; col++)
+    {
+        const struct column_info *info = &table->colinfo[col];
+        UINT bytes = bytes_per_column( db, info, width );
+
+        if ((info->type & MSITYPE_STRING) && !MSITYPE_IS_BINARY(info->type))
+        {
+            for (row = 0; row < rows; row++)
+            {
+                const BYTE *p = data + offset * rows + row * bytes;
+                UINT id = p[0] | (p[1] << 8);
+                if (bytes == 3) id |= p[2] << 16;
+                if (!msi_string_lookup( db->strings, id, NULL )) return FALSE;
+            }
+        }
+        offset += bytes;
+    }
+    return TRUE;
+}
