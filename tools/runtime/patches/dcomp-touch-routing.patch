--- /dev/null
+++ b/dlls/winex11.drv/touch_message_flags.h
@@ -0,0 +1,16 @@
+/* XInput2 touch contact state for the Win32 pointer message.
+ * Modified 2026-10-17: preserve both raw and window-event release semantics.
+ * Derived from the original LVB touch-routing helper, LGPL-2.1-or-later.
+ */
+#ifndef __WINE_X11_TOUCH_MESSAGE_FLAGS_H
+#define __WINE_X11_TOUCH_MESSAGE_FLAGS_H
+
+static inline unsigned int x11drv_touch_message_flags( int evtype, unsigned int flags )
+{
+    if (evtype != XI_RawTouchEnd && evtype != XI_TouchEnd)
+        flags |= POINTER_MESSAGE_FLAG_INCONTACT;
+
+    return POINTER_MESSAGE_FLAG_INRANGE | flags;
+}
+
+#endif
