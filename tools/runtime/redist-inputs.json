  "source_scope": {
    "onnxruntime": "Linux x64 CPU shared Release 1.14.1, c57cf374b67f72575546d7b4c69a1af4972e2b54; native inference dependencies from that revision cmake/deps.txt and external/eigen.cmake. WIL is an unconditional configure input. No GPU, WASM, training, XNNPACK, extension or test dependency closure. These commit ZIPs preserve the selected sources but differ in archive bytes from tag ZIPs; do not substitute them under unchanged upstream SHA1 checks.",
    "speech": "Piper and piper-phonemize link GPLv3 eSpeak. Preserve that linked source closure and build scripts, including matching ONNX sources, rather than describing the combined speech payload as MIT-only. General tools and System Libraries are excluded under GPLv3 section 1.",
    "model": "Shipped libtashkeel_model.ort SHA2569f27090af3e0f661913af048a739632a3f577b3233512551d8c90580ccad4aa8 matches upstream ce8bbbd4bbf916fc9b0b88b3ee1a3c3eb6f6b1e5 model blob7bd74ebd8d9408d85884b6cb68cb89edb218629b. Preserve libtashkeel and credited Shakkala model notices.",
    "collection": "source-companion.py exports selected prepared source components, recipes, patches, Wine configurations and compiler-selected Cargo sources. Extra corresponding_source acquisitions happen only in that explicit command. Normal redist preparation acquires only source_notices archives."
  }
