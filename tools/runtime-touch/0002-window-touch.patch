diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -365,11 +365,15 @@ void x11drv_xinput2_enable( Display *display, Window window )
             XISetMask( mask_bits, XI_RawButtonPress );
             XISetMask( mask_bits, XI_RawButtonRelease );
-
-            XISetMask( mask_bits, XI_RawTouchBegin );
-            XISetMask( mask_bits, XI_RawTouchUpdate );
-            XISetMask( mask_bits, XI_RawTouchEnd );
         }
     }
+    else
+    {
+        /* Touch belongs to the actual X window, including transient popups.
+         * Do not also send an independent root-raw pointer stream. */
+        XISetMask( mask_bits, XI_TouchBegin );
+        XISetMask( mask_bits, XI_TouchUpdate );
+        XISetMask( mask_bits, XI_TouchEnd );
+    }
 
     pXISelectEvents( display, window, &mask, 1 );
 }
@@ -389,7 +393,7 @@ void x11drv_xinput2_disable( Display *display, Window window )
     XIEventMask mask;
 
     if (!xinput2_available) return;
-    if (thread_data->xinput2_rawinput) return;
+    if (thread_data->xinput2_rawinput && window == DefaultRootWindow( display )) return;
 
     mask.mask     = mask_bits;
     mask.mask_len = sizeof(mask_bits);
@@ -1903,33 +1907,41 @@ static BOOL X11DRV_RawButtonEvent( HWND hwnd, XGenericEventCookie *xev )
     return TRUE;
 }
 
-static BOOL X11DRV_RawTouchEvent( HWND hwnd, XGenericEventCookie *xev )
+static BOOL X11DRV_TouchEvent( HWND hwnd, XGenericEventCookie *xev )
 {
-    struct x11drv_thread_data *thread_data = x11drv_thread_data();
+    XIDeviceEvent *event = xev->data;
+    RECT virtual = NtUserGetVirtualScreenRect( MDT_RAW_DPI );
+    INPUT mapped = {.type = INPUT_MOUSE};
     INPUT input = {.type = INPUT_HARDWARE};
-    XIRawEvent *event = xev->data;
     int flags = 0;
     POINT pos;
+    HWND target = 0;
 
-    if (!thread_data->xinput2_rawinput) return FALSE;
-
-    if (!map_raw_event_coords( event, &input, FALSE )) return FALSE;
-    if (!(input.mi.dwFlags & MOUSEEVENTF_ABSOLUTE)) return FALSE;
-    pos.x = input.mi.dx;
-    pos.y = input.mi.dy;
+    /* GenericEvent has no HWND in event.c. Route by the XI delivery window,
+     * including a newly created transient popup, rather than by focus. */
+    if (XFindContext( xev->display, event->event, winContext, (char **)&target )) return FALSE;
+    hwnd = target;
+    if (!hwnd || virtual.right <= virtual.left || virtual.bottom <= virtual.top) return FALSE;
+    mapped.mi.dx = round( event->event_x );
+    mapped.mi.dy = round( event->event_y );
+    map_event_coords( hwnd, event->event, event->root, round( event->root_x ), round( event->root_y ), &mapped );
+    pos.x = max( 0, min( 65535, (LONGLONG)(mapped.mi.dx - virtual.left) * 65535 /
+                              (virtual.right - virtual.left) ) );
+    pos.y = max( 0, min( 65535, (LONGLONG)(mapped.mi.dy - virtual.top) * 65535 /
+                              (virtual.bottom - virtual.top) ) );
 
     switch (event->evtype)
     {
-    case XI_RawTouchBegin:
+    case XI_TouchBegin:
         input.hi.uMsg = WM_POINTERDOWN;
         flags |= POINTER_MESSAGE_FLAG_NEW;
         TRACE("XI_TouchBegin detail %u pos %dx%d, flags %#x\n", event->detail, pos.x, pos.y, flags);
         break;
-    case XI_RawTouchEnd:
+    case XI_TouchEnd:
         input.hi.uMsg = WM_POINTERUP;
         TRACE("XI_TouchEnd detail %u pos %dx%d, flags %#x\n", event->detail, pos.x, pos.y, flags);
         break;
-    case XI_RawTouchUpdate:
+    case XI_TouchUpdate:
         input.hi.uMsg = WM_POINTERUPDATE;
         TRACE("XI_TouchUpdate detail %u pos %dx%d, flags %#x\n", event->detail, pos.x, pos.y, flags);
         break;
@@ -2020,10 +2032,10 @@ BOOL X11DRV_GenericEvent( HWND hwnd, XEvent *xev )
         ret = X11DRV_RawButtonEvent( event );
         break;
 
-    case XI_RawTouchBegin:
-    case XI_RawTouchUpdate:
-    case XI_RawTouchEnd:
-        ret = X11DRV_RawTouchEvent( hwnd, event );
+    case XI_TouchBegin:
+    case XI_TouchUpdate:
+    case XI_TouchEnd:
+        ret = X11DRV_TouchEvent( hwnd, event );
         break;
 
     default:
diff --git a/dlls/winex11.drv/touch_message_flags.h b/dlls/winex11.drv/touch_message_flags.h
--- a/dlls/winex11.drv/touch_message_flags.h
+++ b/dlls/winex11.drv/touch_message_flags.h
@@ -4,7 +4,7 @@
 
 static inline unsigned int x11drv_touch_message_flags( int evtype, unsigned int flags )
 {
-    if (evtype != XI_RawTouchEnd)
+    if (evtype != XI_RawTouchEnd && evtype != XI_TouchEnd)
         flags |= POINTER_MESSAGE_FLAG_INCONTACT;
 
     return POINTER_MESSAGE_FLAG_INRANGE | flags;
