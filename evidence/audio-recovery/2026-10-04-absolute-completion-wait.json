  "behavior": {
    "before": "Signal::wait converted the remaining Instant duration and later entered FUTEX_WAIT with that relative duration, so descheduling between conversion and syscall entry renewed the effective kernel expiry.",
    "after": [
      "Sample CLOCK_MONOTONIC before sampling Instant and conservatively convert the unchanged Instant deadline to a checked absolute timespec.",
      "Use FUTEX_WAIT_BITSET with FUTEX_PRIVATE_FLAG, no FUTEX_CLOCK_REALTIME, null uaddr2 and FUTEX_BITSET_MATCH_ANY.",
      "Clock failure, invalid values, an already-expired Instant or timespec overflow refuses the wait.",
      "A conservative early ETIMEDOUT requests ordinary queue reinspection while the original Instant deadline remains live; at or after that deadline it remains a timeout.",
      "EAGAIN and EINTR retain their prior queue-reinspection result; the sequence comparison guards waiting and the queue remains the authority for completion."
    ],
    "unchanged": [
      "completion allowances and processing modes",
      "queue ownership and inspection",
      "notification and Windows behavior",
      "buffering and runtime selection",
      "privileges"
    ]
  },
